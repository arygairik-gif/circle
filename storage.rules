rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){ return request.auth != null; }
  function isCircleMember(circleId){
   return signedIn() && firestore.exists(/databases/(default)/documents/circles/$(circleId)/members/$(request.auth.uid));
  }
  match /circles/{circleId}/{uid}/{fileName} {
   allow read: if isCircleMember(circleId);
   allow create: if isCircleMember(circleId)
     && request.auth.uid == uid
     && request.resource.size <= 12 * 1024 * 1024
     && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
   allow update: if false;
   allow delete: if signedIn() && request.auth.uid == uid && isCircleMember(circleId);
  }
 }
}