rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function memberPath(cid,uid){ return /databases/$(database)/documents/circles/$(cid)/members/$(uid); }
  function circlePath(cid){ return /databases/$(database)/documents/circles/$(cid); }
  function invitePath(code){ return /databases/$(database)/documents/invites/$(code); }
  function isMember(cid){
   return signedIn() && exists(memberPath(cid,request.auth.uid));
  }
  function isMemberAfter(cid){
   return signedIn() && existsAfter(memberPath(cid,request.auth.uid));
  }
  function isOwner(cid){
   return isMember(cid) && get(circlePath(cid)).data.ownerUid == request.auth.uid;
  }
  function validInvite(cid,code){
   return code is string && exists(invitePath(code)) &&
    get(invitePath(code)).data.circleId == cid &&
    !('revokedAt' in get(invitePath(code)).data) &&
    (!('expiresAt' in get(invitePath(code)).data) ||
      get(invitePath(code)).data.expiresAt > request.time);
  }
  function validMemberFields(uid){
   return request.resource.data.keys().hasOnly([
     'uid','name','handle','bio','photoURL','role','status','joinedAt','inviteCode'
    ]) &&
    request.resource.data.keys().hasAll([
     'uid','name','handle','bio','photoURL','role','status','joinedAt'
    ]) &&
    request.resource.data.uid == uid &&
    request.resource.data.name is string &&
    request.resource.data.name.size() > 0 &&
    request.resource.data.name.size() <= 40 &&
    request.resource.data.handle is string &&
    request.resource.data.handle.size() <= 24 &&
    request.resource.data.bio is string &&
    request.resource.data.bio.size() <= 160 &&
    request.resource.data.photoURL is string &&
    request.resource.data.photoURL.size() <= 220000 &&
    (request.resource.data.photoURL.size() == 0 ||
     request.resource.data.photoURL.matches('^data:image/.*') ||
     request.resource.data.photoURL.matches('^https://lh[0-9][.]googleusercontent[.]com/.*') ||
     request.resource.data.photoURL.matches('^https://firebasestorage[.]googleapis[.]com/.*')) &&
    request.resource.data.role in ['owner','member'] &&
    request.resource.data.status in ['around','free'] &&
    request.resource.data.joinedAt == request.time;
  }
  function validText(data,key,max,min){
   return data[key] is string && data[key].size() >= min && data[key].size() <= max;
  }
  function validMedia(data){
   return (!('mediaUrl' in data) ||
     (data.mediaUrl is string && data.mediaUrl.size() <= 420000 &&
      (data.mediaUrl.matches('^data:(image|audio)/.*') ||
       data.mediaUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')))) &&
    (!('mediaType' in data) || data.mediaType in ['image','audio']);
  }

  match /users/{uid} {
   allow read,create,update: if signedIn() && request.auth.uid == uid;
   allow delete: if false;

   match /circles/{cid} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create: if signedIn() && request.auth.uid == uid &&
      existsAfter(memberPath(cid,uid));
    allow update: if isOwner(cid) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
      request.resource.data.role == (getAfter(circlePath(cid)).data.ownerUid == uid ? 'owner' : 'member');
    allow delete: if signedIn() && ((request.auth.uid == uid && get(circlePath(cid)).data.ownerUid != uid) || (isOwner(cid) && uid != get(circlePath(cid)).data.ownerUid));
   }

   match /stickers/{sid} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create: if signedIn() && request.auth.uid == uid &&
      request.resource.data.uid == uid &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.keys().hasOnly(['uid','name','dataUrl','createdAt']) &&
      validText(request.resource.data,'name',40,1) &&
      request.resource.data.dataUrl is string &&
      request.resource.data.dataUrl.size() > 0 &&
      request.resource.data.dataUrl.size() <= 180000 &&
      request.resource.data.dataUrl.matches('^data:image/.*');
    allow update: if false;
    allow delete: if signedIn() && request.auth.uid == uid &&
      resource.data.uid == uid;
   }
  }

  match /invites/{code} {
   // Invite codes are high-entropy, but only their exact document can be fetched.
   allow get: if signedIn();
   allow list: if false;
   allow create: if signedIn() &&
    request.resource.data.createdBy == request.auth.uid &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.expiresAt is timestamp &&
    request.resource.data.expiresAt > request.time &&
    request.resource.data.keys().hasOnly(['circleId','circleName','createdBy','createdAt','expiresAt']) &&
    validText(request.resource.data,'circleName',40,1) &&
    existsAfter(memberPath(request.resource.data.circleId,request.auth.uid));
   allow update: if signedIn() &&
    isOwner(resource.data.circleId) &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']) &&
    request.resource.data.revokedAt == request.time;
   allow delete: if signedIn() && isOwner(resource.data.circleId);
  }

  match /circles/{cid} {
   allow create: if signedIn() &&
    request.resource.data.ownerUid == request.auth.uid &&
    request.resource.data.createdAt == request.time &&
    request.resource.data.keys().hasOnly(['name','ownerUid','inviteCode','createdAt']) &&
    validText(request.resource.data,'name',40,1) &&
    validText(request.resource.data,'inviteCode',24,8);
   allow read: if isMember(cid);
   allow update: if isOwner(cid) && (
    (
     request.resource.data.ownerUid == resource.data.ownerUid &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','inviteCode','updatedAt']) &&
     (!('name' in request.resource.data) || validText(request.resource.data,'name',40,1)) &&
     (!('inviteCode' in request.resource.data) || validText(request.resource.data,'inviteCode',24,8))
    ) || (
     request.resource.data.ownerUid is string &&
     request.resource.data.ownerUid != resource.data.ownerUid &&
     existsAfter(memberPath(cid,request.resource.data.ownerUid)) &&
     getAfter(memberPath(cid,request.resource.data.ownerUid)).data.role == 'owner' &&
     getAfter(memberPath(cid,request.auth.uid)).data.role == 'member' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','updatedAt']) &&
     request.resource.data.updatedAt == request.time
    )
   );
   allow delete: if false;

   match /members/{uid} {
    allow get: if signedIn() &&
      (request.auth.uid == uid || isMember(cid));
    allow list: if isMember(cid);
    allow create: if signedIn() && request.auth.uid == uid &&
      validMemberFields(uid) &&
      (
       (getAfter(circlePath(cid)).data.ownerUid == uid &&
        request.resource.data.role == 'owner') ||
       (request.resource.data.role == 'member' &&
        'inviteCode' in request.resource.data &&
        validInvite(cid,request.resource.data.inviteCode))
      );
    allow update: if signedIn() && request.auth.uid == uid &&
      isMember(cid) &&
      request.resource.data.uid == uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       'name','photoURL','handle','bio','status','freeUntil','lastSeen',
       'mood','activity','support','supportPreference','listeningTrackTitle','listeningArtist','listeningArtwork','listeningAt','email'
      ]) &&
      (!('email' in request.resource.data) ||
       request.resource.data.email == resource.data.email) &&
      (!('name' in request.resource.data) || validText(request.resource.data,'name',40,1)) &&
      (!('handle' in request.resource.data) ||
       (request.resource.data.handle is string && request.resource.data.handle.size() <= 24)) &&
      (!('bio' in request.resource.data) ||
       (request.resource.data.bio is string && request.resource.data.bio.size() <= 160)) &&
      (!('listeningTrackTitle' in request.resource.data) || validText(request.resource.data,'listeningTrackTitle',160,0)) &&
      (!('listeningArtist' in request.resource.data) || validText(request.resource.data,'listeningArtist',160,0)) &&
      (!('listeningArtwork' in request.resource.data) || (request.resource.data.listeningArtwork is string && request.resource.data.listeningArtwork.size() <= 1000)) &&
      (!('listeningAt' in request.resource.data) || request.resource.data.listeningAt == null || request.resource.data.listeningAt == request.time) &&
      (!('photoURL' in request.resource.data) ||
       (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 220000 &&
        (request.resource.data.photoURL.size() == 0 ||
         request.resource.data.photoURL.matches('^data:image/.*') ||
         request.resource.data.photoURL.matches('^https://lh[0-9][.]googleusercontent[.]com/.*') ||
         request.resource.data.photoURL.matches('^https://firebasestorage[.]googleapis[.]com/.*')))) &&
      (!('status' in request.resource.data) ||
       request.resource.data.status in ['around','free']) &&
      (!('freeUntil' in request.resource.data) ||
       request.resource.data.freeUntil == null ||
       request.resource.data.freeUntil is timestamp) &&
      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen']) ||
       request.resource.data.lastSeen == request.time);
    allow update: if isOwner(cid) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
      request.resource.data.role == (getAfter(circlePath(cid)).data.ownerUid == uid ? 'owner' : 'member');
    allow delete: if signedIn() && (
      (request.auth.uid == uid && get(circlePath(cid)).data.ownerUid != uid) ||
      (isOwner(cid) && uid != get(circlePath(cid)).data.ownerUid)
     );
    // The owner can remove legacy email fields from public member documents.
    // New member documents keep email only in the private users/{uid} document.
    allow update: if isOwner(cid) &&
     resource.data.keys().hasAny(['email']) &&
     !request.resource.data.keys().hasAny(['email']) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
   }
    match /messages/{mid} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','displayName','text','reply','replyTo','attachmentDataUrl',
       'attachmentType','attachmentName','createdAt'
      ]) &&
      request.resource.data.keys().hasAll(['uid','displayName','text','createdAt']) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.displayName is string &&
      request.resource.data.displayName.size() > 0 &&
      request.resource.data.displayName.size() <= 40 &&
      request.resource.data.displayName == get(memberPath(cid,request.auth.uid)).data.name &&
      request.resource.data.text is string &&
      request.resource.data.text.size() > 0 &&
      request.resource.data.text.size() <= 1500 &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.createdAt == request.time &&
      (!('reply' in request.resource.data) ||
       (request.resource.data.reply is string &&
        request.resource.data.reply.size() <= 320)) &&
      (!('replyTo' in request.resource.data) ||
       (request.resource.data.replyTo is string &&
        request.resource.data.replyTo.size() <= 128)) &&
      (!('attachmentType' in request.resource.data) ||
       request.resource.data.attachmentType in ['image','audio','sticker']) &&
      (!('attachmentName' in request.resource.data) ||
       (request.resource.data.attachmentName is string &&
        request.resource.data.attachmentName.size() <= 100)) &&
      (!('attachmentDataUrl' in request.resource.data) ||
       (request.resource.data.attachmentDataUrl is string &&
        request.resource.data.attachmentDataUrl.size() <= 420000 &&
        request.resource.data.attachmentDataUrl.matches('^data:(image|audio)/.*')));
     allow update: if isMember(cid) && (
      (resource.data.uid == request.auth.uid &&
       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt']) &&
       request.resource.data.text is string &&
       request.resource.data.text.size() > 0 &&
       request.resource.data.text.size() <= 1500 &&
       request.resource.data.editedAt == request.time) ||
      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsByUser']) &&
       request.resource.data.reactionsByUser is map &&
       request.resource.data.reactionsByUser
        .diff(resource.data.get('reactionsByUser',{}))
        .affectedKeys().hasOnly([request.auth.uid]) &&
       (!(request.auth.uid in request.resource.data.reactionsByUser) ||
        (request.resource.data.reactionsByUser[request.auth.uid] is list &&
         request.resource.data.reactionsByUser[request.auth.uid].size() <= 32 &&
         request.resource.data.reactionsByUser[request.auth.uid].hasOnly([
          '❤️','😂','😍','🥹','😭','😮','😡','👍','👎','🙌','👏','🔥',
          '🎉','✨','💯','🫶','🤝','👀','🥳','💀','😎','🤔','🙏','💚',
          '🤍','💛','🫡','🥰','😅','💖','🧡','💜'
         ]))))
     );
     allow delete: if isMember(cid) &&
      resource.data.uid == request.auth.uid;
    }

    match /commitments/{itemId} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly(['uid','createdAt','text','by','when','done']) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'text',240,1) &&
      validText(request.resource.data,'by',40,1) &&
      request.resource.data.when is string &&
      request.resource.data.when.size() <= 80 &&
      request.resource.data.done is bool;
     allow update: if isMember(cid) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','updatedAt']) &&
      request.resource.data.done is bool &&
      request.resource.data.updatedAt == request.time;
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /memories/{itemId} {
     allow read: if isMember(cid) && resource.data.type != 'time-capsule';
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','createdAt','type','icon','title','desc','date','by','color',
       'unlockAt','mediaUrl','mediaType'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.type in ['photo','voice','link','milestone'] &&
      validText(request.resource.data,'icon',8,0) &&
      validText(request.resource.data,'title',100,1) &&
      validText(request.resource.data,'desc',1200,0) &&
      request.resource.data.date is string &&
      request.resource.data.date.size() <= 10 &&
      validText(request.resource.data,'by',40,1) &&
      request.resource.data.color is string &&
      request.resource.data.color.size() <= 20 &&
      (!('unlockAt' in request.resource.data) ||
       request.resource.data.unlockAt == null ||
       (request.resource.data.unlockAt is string &&
        request.resource.data.unlockAt.size() <= 40)) &&
      validMedia(request.resource.data);
     allow update: if false;
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /rituals/{itemId} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly(['uid','createdAt','title','day','detail']) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'title',100,1) &&
      validText(request.resource.data,'day',3,1) &&
      request.resource.data.detail is string &&
      request.resource.data.detail.size() <= 240;
     allow update: if false;
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /quests/{itemId} {
     allow read: if isMember(cid);
     allow create: if isMemberAfter(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','createdAt','title','desc','icon','doneBy'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'title',100,1) &&
      request.resource.data.desc is string &&
      request.resource.data.desc.size() <= 300 &&
      request.resource.data.icon is string &&
      request.resource.data.icon.size() <= 8 &&
      request.resource.data.doneBy is map &&
      request.resource.data.doneBy.size() == 0;
     allow update: if isMember(cid) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneBy']) &&
      request.resource.data.doneBy is map &&
      request.resource.data.doneBy
       .diff(resource.data.get('doneBy',{}))
       .affectedKeys().hasOnly([request.auth.uid]) &&
      (!(request.auth.uid in request.resource.data.doneBy) ||
       request.resource.data.doneBy[request.auth.uid] == true);
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /activities/{itemId} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','createdAt','type','answer','unlock','title'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'type',40,1) &&
      request.resource.data.answer is string &&
      request.resource.data.answer.size() <= 1500 &&
      request.resource.data.unlock is string &&
      request.resource.data.unlock.size() <= 40 &&
      validText(request.resource.data,'title',100,1);
     allow update: if false;
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /tracks/{trackId} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','createdAt','providerId','title','artist','album','artwork',
       'previewUrl','trackUrl','source','durationMs'
      ]) &&
      request.resource.data.keys().hasAll([
       'uid','createdAt','providerId','title','artist','album','artwork',
       'previewUrl','trackUrl','source','durationMs'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'providerId',40,1) &&
      validText(request.resource.data,'title',160,1) &&
      validText(request.resource.data,'artist',160,1) &&
      request.resource.data.album is string && request.resource.data.album.size() <= 160 &&
      request.resource.data.artwork is string && request.resource.data.artwork.size() <= 1000 &&
      request.resource.data.previewUrl is string && request.resource.data.previewUrl.size() <= 1000 &&
      request.resource.data.trackUrl is string && request.resource.data.trackUrl.size() <= 1000 &&
      request.resource.data.source == 'itunes' &&
      request.resource.data.durationMs is int &&
      request.resource.data.durationMs >= 0 && request.resource.data.durationMs <= 3600000;
     allow update: if false;
     allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
    }

    match /plans/{pid} {
     allow read: if isMember(cid);
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'title','description','date','time','place','options','votes','rsvps',
       'status','createdBy','createdAt'
      ]) &&
      request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.createdAt == request.time &&
      validText(request.resource.data,'title',100,1) &&
      request.resource.data.description is string &&
      request.resource.data.description.size() <= 500 &&
      request.resource.data.date is string &&
      request.resource.data.date.size() <= 10 &&
      request.resource.data.time is string &&
      request.resource.data.time.size() <= 40 &&
      request.resource.data.place is string &&
      request.resource.data.place.size() <= 120 &&
      request.resource.data.options is list &&
      request.resource.data.options.size() >= 1 &&
      request.resource.data.options.size() <= 8 &&
      request.resource.data.votes is map &&
      request.resource.data.votes.size() == 0 &&
      request.resource.data.rsvps is map &&
      request.resource.data.rsvps.size() == 0 &&
      request.resource.data.status == 'Voting open';
     allow update: if isMember(cid) && (
      (
       resource.data.createdBy == request.auth.uid &&
       request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['title','description','date','time','place','status']) &&
       validText(request.resource.data,'title',100,1) &&
       request.resource.data.description is string &&
       request.resource.data.description.size() <= 500 &&
       request.resource.data.date is string &&
       request.resource.data.date.size() <= 10 &&
       request.resource.data.time is string &&
       request.resource.data.time.size() <= 40 &&
       request.resource.data.place is string &&
       request.resource.data.place.size() <= 120 &&
       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['Voting open','Finalized'])
      ) ||
      (
       request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['votes','rsvps']) &&
       request.resource.data.votes is map &&
       request.resource.data.rsvps is map &&
       request.resource.data.votes.diff(resource.data.votes)
        .affectedKeys().hasOnly([request.auth.uid]) &&
       request.resource.data.rsvps.diff(resource.data.rsvps)
        .affectedKeys().hasOnly([request.auth.uid]) &&
       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['votes']) ||
        resource.data.status == 'Voting open') &&
       (!(request.auth.uid in request.resource.data.votes) ||
        (request.resource.data.votes[request.auth.uid] is int &&
         request.resource.data.votes[request.auth.uid] >= 0 &&
         request.resource.data.votes[request.auth.uid] < resource.data.options.size())) &&
       (!(request.auth.uid in request.resource.data.rsvps) ||
        request.resource.data.rsvps[request.auth.uid] is bool)
      )
     );
     allow delete: if isMember(cid) && resource.data.createdBy == request.auth.uid;
    }

    match /privateReplies/{replyId} {
     allow create: if isMember(cid) &&
      request.resource.data.keys().hasOnly([
       'uid','createdAt','fromUid','toUid','messageId','reply'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.fromUid == request.auth.uid &&
      request.resource.data.toUid is string &&
      request.resource.data.toUid != request.auth.uid &&
      exists(memberPath(cid,request.resource.data.toUid)) &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.messageId is string &&
      validText(request.resource.data,'reply',1500,1);
     allow read: if isMember(cid) &&
      (resource.data.fromUid == request.auth.uid ||
       resource.data.toUid == request.auth.uid);
     allow update,delete: if false;
    }

    match /dailyDrops/{date}/answers/{uid} {
     allow create: if isMember(cid) &&
      request.auth.uid == uid &&
      request.resource.data.keys().hasOnly([
       'uid','date','prompt','answer','name','createdAt','photoDataUrl'
      ]) &&
      request.resource.data.uid == uid &&
      request.resource.data.date == date &&
      request.resource.data.name ==
       get(memberPath(cid,request.auth.uid)).data.name &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.prompt is string &&
      request.resource.data.prompt.size() <= 300 &&
      request.resource.data.answer is string &&
      request.resource.data.answer.size() <= 1000 &&
      (
       request.resource.data.answer.size() > 0 ||
       ('photoDataUrl' in request.resource.data &&
        request.resource.data.photoDataUrl is string &&
        request.resource.data.photoDataUrl.size() > 0)
      ) &&
      (!('photoDataUrl' in request.resource.data) ||
       (request.resource.data.photoDataUrl is string &&
        request.resource.data.photoDataUrl.size() <= 200000));
     allow get: if isMember(cid) &&
      (request.auth.uid == uid ||
       exists(/databases/$(database)/documents/circles/$(cid)/dailyDrops/$(date)/answers/$(request.auth.uid)));
     allow list: if isMember(cid) &&
      exists(/databases/$(database)/documents/circles/$(cid)/dailyDrops/$(date)/answers/$(request.auth.uid));
     allow update,delete: if false;
    }
  }
 }
}